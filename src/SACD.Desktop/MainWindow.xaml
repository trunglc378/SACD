<Window x:Class="SACD.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SACD.Desktop.ViewModels"
        xmlns:local="clr-namespace:SACD.Desktop"
        mc:Ignorable="d"
        Title="SACD — Tự động hóa xử lý văn bản" Height="780" Width="1180"
        WindowStartupLocation="CenterScreen" MinWidth="1000" MinHeight="650"
        Background="#F5F7FA">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <local:VietnameseDisplay x:Key="VietnameseDisplay"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0D47A1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="SACD — TỰ ĐỘNG HÓA QUY TRÌNH XỬ LÝ VĂN BẢN VÀ TỔNG HỢP TÀI LIỆU" 
                               FontSize="17" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Phần mềm trên máy nội bộ | Hỗ trợ quản lý văn bản, tự động hóa có kiểm soát và kiểm chứng số liệu"
                               FontSize="12" Foreground="#BBDEFB" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1565C0" CornerRadius="4" Padding="10,4" Margin="4,0">
                        <TextBlock Text="{Binding MachineProfile, Converter={StaticResource VietnameseDisplay}}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace Tabs -->
        <TabControl Grid.Row="1" Margin="10" SelectedIndex="{Binding SelectedTabIndex}">
            
            <!-- Tab 1: Workspace -->
            <TabItem Header="1. Chọn máy / Mở kho">
                <Grid Margin="15">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock Text="Cấu hình kho làm việc trên máy" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#0D47A1"/>
                        <TextBlock Text="Đường dẫn lưu trữ dữ liệu và tệp gốc:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBox Text="{Binding WorkspacePath, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="13"/>
                        <TextBlock Text="Chọn vai trò khi tạo kho mới. Kho đã có sẽ giữ vai trò ban đầu." TextWrapping="Wrap" Margin="0,12,0,5"/>
                        <ComboBox ItemsSource="{Binding MachineProfiles}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding SelectedMachineProfile}" Padding="6"/>
                        <TextBlock Text="Sau khi mở kho, chuyển sang mục 2. Quy trình văn thư. Khi thử hai máy trên cùng máy tính, dùng hai thư mục kho riêng." TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button Content="Mở / Khởi tạo Kho làm việc" Command="{Binding OpenWorkspaceCommand}" Background="#2E7D32"/>
                            <Button Content="Tạo bản sao lưu (.zip)" Command="{Binding BackupWorkspaceCommand}" Background="#455A64"/>
                        </StackPanel>
                        <Border Background="#E3F2FD" CornerRadius="4" Padding="15" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Thông tin kiểm soát an toàn:" FontWeight="Bold" Foreground="#0D47A1"/>
                                <TextBlock Text="• Mỗi kho chỉ cho phép 1 phiên ghi độc quyền; ngăn chặn hai tiến trình ghi đồng thời." Margin="0,4"/>
                                <TextBlock Text="• Kiểm tra liên kết dữ liệu và hỗ trợ tìm kiếm toàn văn trong kho." Margin="0,4"/>
                                <TextBlock Text="• Cách ly mạng ngoài: Hoạt động hoàn toàn trên máy nội bộ; không gửi dữ liệu ra mạng ngoài." Margin="0,4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: Intake & Review -->
            <TabItem Header="2. Quy trình văn thư">
                <Grid>
                    <TextBlock Text="Mở kho tại mục 1 trước khi bắt đầu. Chọn vai trò Máy 1 hoặc Máy 2 và dùng kho riêng cho từng máy." Margin="20" TextWrapping="Wrap" VerticalAlignment="Top"/>
                    <local:CorrespondenceView DataContext="{Binding CaseDesk}">
                        <local:CorrespondenceView.Style><Style TargetType="local:CorrespondenceView">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsWorkspaceOpen,RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style></local:CorrespondenceView.Style>
                    </local:CorrespondenceView>
                </Grid>
            </TabItem>
            <TabItem Header="Thử văn bản mẫu">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Document List -->
                    <Border Grid.Column="0" Margin="0,0,5,0" Background="White" CornerRadius="4" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Tiếp nhận văn bản mẫu" Command="{Binding ImportFilesCommand}"/>
                                <TextBlock Text="Danh sách tệp gốc đã nhập:" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ImportedDocuments}" SelectedItem="{Binding SelectedDocument}"
                                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên văn bản" Binding="{Binding OriginalPath}" Width="*"/>
                                    <DataGridTextColumn Header="Dung lượng (byte)" Binding="{Binding SizeBytes}" Width="120"/>
                                    <DataGridTextColumn Header="Trùng lặp" Binding="{Binding Deduplicated, Converter={StaticResource VietnameseDisplay}, ConverterParameter=Boolean}" Width="80"/>
                                    <DataGridTextColumn Header="Mã kiểm tra tệp" Binding="{Binding ObjectHash}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Right: Text Blocks Review -->
                    <Border Grid.Column="1" Margin="5,0,0,0" Background="White" CornerRadius="4" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Các đoạn văn bản đã trích xuất &amp; đối chiếu:" FontWeight="Bold" Margin="0,0,0,10"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding DocumentTextBlocks}" AutoGenerateColumns="False" GridLinesVisibility="All">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT" Binding="{Binding Ordinal}" Width="50" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Vị trí nguồn" Binding="{Binding LocatorJson, Converter={StaticResource VietnameseDisplay}, ConverterParameter=Locator}" Width="130" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Nội dung đã chuẩn hóa" Binding="{Binding RawTextNfc}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="Xác nhận đã đối chiếu" Command="{Binding ReviewTextCommand}" Background="#2E7D32"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 3: Deadlines & Tasks -->
            <TabItem Header="Nhiệm vụ bổ sung">
                <Grid Margin="10" Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                        <Button Content="+ Tạo nhiệm vụ mới" Command="{Binding CreateTaskCommand}"/>
                        <Button Content="Đánh dấu hoàn thành" Command="{Binding CompleteTaskCommand}" Background="#00897B"/>
                        <TextBlock Text="Theo dõi hạn xử lý (Còn hạn, Sắp hết hạn, Quá hạn):" VerticalAlignment="Center" FontWeight="Bold" Margin="15,0,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TasksList}" SelectedItem="{Binding SelectedTask}"
                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hồ sơ" Binding="{Binding DossierCode}" Width="130"/>
                            <DataGridTextColumn Header="Nội dung công việc" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Cán bộ phụ trách" Binding="{Binding AssigneeName}" Width="150"/>
                            <DataGridTextColumn Header="Hạn xử lý" Binding="{Binding DueDate}" Width="110"/>
                            <DataGridTextColumn Header="Tình trạng hạn" Binding="{Binding DeadlineText}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding State, Converter={StaticResource VietnameseDisplay}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 4: Search & Audit -->
            <TabItem Header="Tra cứu văn bản">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="White" Padding="10" CornerRadius="4" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="13"/>
                            <Button Grid.Column="1" Content="Tìm kiếm toàn văn" Command="{Binding SearchCommand}" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="White" Padding="10" CornerRadius="4">
                        <DataGrid ItemsSource="{Binding SearchResults}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hồ sơ" Binding="{Binding DossierCode}" Width="120"/>
                                <DataGridTextColumn Header="Tệp nguồn" Binding="{Binding DocumentName}" Width="200"/>
                                <DataGridTextColumn Header="Đoạn trích kết quả khớp" Binding="{Binding Snippet}" Width="*"/>
                                <DataGridTextColumn Header="Phiên bản nội dung" Binding="{Binding VersionNo}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 5: Word Report Studio -->
            <TabItem Header="Báo cáo tổng hợp">
                <Grid Margin="15" Background="White">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="10">
                        <TextBlock Text="Tạo và xuất báo cáo tổng hợp (.docx)" FontSize="16" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,15"/>
                        <TextBlock Text="Tiêu đề báo cáo:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBox Text="{Binding ReportTitle, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="13"/>

                        <TextBlock Text="Thư mục xuất báo cáo:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                        <TextBox Text="{Binding ReportExportPath, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="13"/>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Xuất báo cáo bản nháp" Command="{Binding ExportDraftReportCommand}" Background="#E65100"/>
                            <Button Content="Xuất báo cáo trình lãnh đạo" Command="{Binding ExportSubmissionReportCommand}" Background="#2E7D32"/>
                        </StackPanel>

                        <Border Background="#F1F8E9" CornerRadius="4" Padding="15" Margin="0,25,0,0">
                            <StackPanel>
                                <TextBlock Text="Trạng thái xuất gần nhất:" FontWeight="Bold" Foreground="#1B5E20"/>
                                <TextBlock Text="{Binding LastExportStatus}" Margin="0,5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 6: RPA Studio -->
            <TabItem Header="Tự động hóa mô phỏng">
                <Grid Margin="15" Background="White">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="10">
                        <TextBlock Text="Thử trạng thái Tự động hóa mô phỏng — không nhập dữ liệu vào QLVB thật" FontSize="16" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,15"/>
                        <TextBlock Text="Kịch bản mẫu được cấp quyền: 'Tự động điền số văn bản, trích yếu và thời hạn vào phần mềm QLVB'." Margin="0,5"/>
                        <Button Content="Chạy kịch bản có điểm dừng kiểm tra" Command="{Binding RunRpaMacroCommand}" Margin="0,15,0,0" Width="420" HorizontalAlignment="Left"/>

                        <Border Background="#FFF3E0" CornerRadius="4" Padding="15" Margin="0,25,0,0">
                            <StackPanel>
                                <TextBlock Text="Nguyên tắc tự động hóa an toàn:" FontWeight="Bold" Foreground="#E65100"/>
                                <TextBlock Text="• Chuẩn bị → Thực hiện → Đối soát hoặc yêu cầu kiểm tra lại." Margin="0,4"/>
                                <TextBlock Text="• Có điểm dừng chờ cán bộ để cán bộ kiểm tra trước khi thực hiện thao tác lưu." Margin="0,4"/>
                                <TextBlock Text="• Không tự ý thử lại khi chưa biết kết quả của lần thao tác trước." Margin="0,4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#ECEFF1" Padding="15,6" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#37474F" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
