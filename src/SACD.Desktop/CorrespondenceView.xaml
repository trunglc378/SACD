<UserControl x:Class="SACD.Desktop.CorrespondenceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="White">
 <UserControl.Resources>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,2,10,7"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="2,3"/>
   <Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
 </UserControl.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#E3F2FD" Padding="12"><StackPanel>
   <TextBlock Text="TRỢ LÝ VĂN THƯ — HỒ SƠ THEO QUY TRÌNH HAI MÁY" FontSize="18" FontWeight="Bold"/>
   <TextBlock Text="{Binding RoleGuide}" Margin="0,6,0,0"/>
   <TextBlock Text="Email chưa kết nối tự động: kiểm tra hộp thư nội bộ, tải tệp rồi chọn Tiếp nhận. Khi không có email, không cần tạo hồ sơ." Margin="0,4,0,0"/>
  </StackPanel></Border>
  <TextBlock Grid.Row="1" Text="{Binding DeadlineAlert}" Foreground="#B71C1C" FontWeight="Bold" Margin="4,8"/>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="Tra mã hồ sơ / quét QR bằng đầu đọc bàn phím"/>
     <TextBox Text="{Binding Filter,UpdateSourceTrigger=PropertyChanged}"/>
     <Button Content="Tra cứu / Tải lại danh sách" Command="{Binding ActionCommand}" CommandParameter="Refresh"/>
     <WrapPanel>
      <Button Content="M1 · Tiếp nhận tệp thật" Command="{Binding ActionCommand}" CommandParameter="Receive"/>
      <Button Content="M2 · Nhập gói USB" Command="{Binding ActionCommand}" CommandParameter="Import"/>
     </WrapPanel>
     <CheckBox IsChecked="{Binding PackageScanned}" Margin="4,6"><TextBlock Text="Gói USB đã được kiểm tra mã độc theo quy trình đơn vị" TextWrapping="Wrap"/><CheckBox.ToolTip>SACD kiểm tra checksum; việc kiểm tra mã độc do công cụ của đơn vị thực hiện.</CheckBox.ToolTip></CheckBox>
    </StackPanel>
    <DataGrid ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0">
     <DataGrid.Columns><DataGridTextColumn Header="Mã hồ sơ" Binding="{Binding Code}" Width="145" MinWidth="145"/>
      <DataGridTextColumn Header="Trạng thái" Binding="{Binding StateLabel}" Width="180" MinWidth="180"/>
      <DataGridTextColumn Header="Hạn xử lý" Binding="{Binding DeadlineLabel}" Width="130"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="{Binding SelectedCase.Code}" FontSize="17" FontWeight="Bold"/>
     <TextBlock Text="{Binding SelectedCase.StateLabel}" Foreground="#1565C0" FontWeight="Bold" Margin="0,4"/>
     <Border Background="#FFF8E1" Padding="10" Margin="0,4,0,10"><TextBlock Text="{Binding NextStep}"/></Border>
     <TextBlock Text="1. Thông tin văn bản — ngày nhập theo yyyy-MM-dd, hạn chưa rõ để trống" FontWeight="Bold"/>
     <UniformGrid Columns="2">
      <StackPanel><TextBlock Text="Số văn bản"/><TextBox Text="{Binding SelectedCase.Number,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel><TextBlock Text="Loại văn bản"/><TextBox Text="{Binding SelectedCase.DocumentType,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel><TextBlock Text="Ngày ban hành"/><TextBox Text="{Binding SelectedCase.IssuedDate,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel><TextBlock Text="Đơn vị ban hành"/><TextBox Text="{Binding SelectedCase.Issuer,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel><TextBlock Text="Đơn vị nhận"/><TextBox Text="{Binding SelectedCase.Recipient,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel><TextBlock Text="Người ký văn bản"/><TextBox Text="{Binding SelectedCase.Signer,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel><TextBlock Text="Độ mật (cán bộ xác nhận theo văn bản)"/><TextBox Text="{Binding SelectedCase.Classification,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel><TextBlock Text="Căn cứ / mốc giải mật nếu có"/><TextBox Text="{Binding SelectedCase.DeclassificationBasis,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     </UniformGrid>
     <TextBlock Text="Trích yếu / nội dung chính"/><TextBox Text="{Binding SelectedCase.Summary,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"/>
     <TextBlock Text="Vấn đề, công việc liên quan đến đơn vị"/><TextBox Text="{Binding SelectedCase.RelatedWork,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"/>
     <UniformGrid Columns="2">
      <StackPanel><TextBlock Text="Hạn giải quyết"/><TextBox Text="{Binding SelectedCase.DueDate,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel><TextBlock Text="Cán bộ đề xuất lãnh đạo / chỉ huy / đội"/><TextBox Text="{Binding SelectedCase.ProposedReceiver,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     </UniformGrid>
     <WrapPanel>
      <Button Content="Lưu thông tin" Command="{Binding ActionCommand}" CommandParameter="Save"/>
      <Button Content="Mở tệp gốc / In" Command="{Binding ActionCommand}" CommandParameter="Open"/>
      <Button Content="M1 · Xác nhận đã đối chiếu" Command="{Binding ActionCommand}" CommandParameter="Confirm"/>
      <Button Content="M1 · Xác nhận đã in giấy" Command="{Binding ActionCommand}" CommandParameter="Printed"/>
      <Button Content="M1 · Xuất gói USB" Command="{Binding ActionCommand}" CommandParameter="Export"/>
     </WrapPanel>
     <Expander Header="Nội dung trích xuất để đối chiếu — PDF/scan cần kiểm tra tệp gốc" Margin="0,8">
      <TextBox Text="{Binding TextPreview,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto"/>
     </Expander>
     <TextBlock Text="2. Máy 2 — QLVB và trình lãnh đạo" FontWeight="Bold" Margin="0,10,0,5"/>
     <TextBlock Text="Mã hồ sơ / số đến đã lưu trong QLVB"/><TextBox Text="{Binding SelectedCase.ExternalRef,UpdateSourceTrigger=PropertyChanged}"/>
     <WrapPanel>
      <Button Content="RPA · Điền QLVB theo cấu hình" Command="{Binding ActionCommand}" CommandParameter="Rpa"/>
      <Button Content="Đối soát đã lưu QLVB" Command="{Binding ActionCommand}" CommandParameter="Register"/>
      <Button Content="Tạo phiếu Word + QR để in" Command="{Binding ActionCommand}" CommandParameter="Slip"/>
      <Button Content="Xác nhận đã trình phiếu + tài liệu" Command="{Binding ActionCommand}" CommandParameter="Submit"/>
     </WrapPanel>
     <TextBlock Text="RPA điền 4 trường rồi dừng để cán bộ kiểm tra và bấm Lưu tại QLVB. Cần mapping đã khảo sát; có thể nhập thủ công khi chưa cấu hình." Margin="0,4"/>
     <UniformGrid Columns="2">
      <StackPanel><TextBlock Text="Lãnh đạo ký duyệt thực tế"/><TextBox Text="{Binding SelectedCase.Leader,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel><TextBlock Text="Người / đội được giao theo quyết định"/><TextBox Text="{Binding SelectedCase.ApprovedReceiver,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     </UniformGrid>
     <TextBlock Text="Căn cứ phiếu đã ký (số phiếu / ngày / vị trí lưu bản ký)"/><TextBox Text="{Binding SelectedCase.DecisionEvidence,UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Text="3. Giao nhận và theo dõi thực hiện" FontWeight="Bold" Margin="0,10,0,5"/>
     <TextBlock Text="Căn cứ người nhận đã ký (họ tên / ngày / sổ hoặc bản ký)"/><TextBox Text="{Binding SelectedCase.ReceiptEvidence,UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Text="Ghi chú / căn cứ của thao tác sắp xác nhận (bắt buộc)"/><TextBox Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="45"/>
     <WrapPanel>
      <Button Content="Cập nhật đã duyệt" Command="{Binding ActionCommand}" CommandParameter="Approve"/>
      <Button Content="Đã giao bản giấy" Command="{Binding ActionCommand}" CommandParameter="Deliver"/>
      <Button Content="Xác nhận ký nhận" Command="{Binding ActionCommand}" CommandParameter="Receipt"/>
      <Button Content="Xác nhận hoàn thành" Command="{Binding ActionCommand}" CommandParameter="Complete"/>
     </WrapPanel>
     <TextBlock Text="Lịch sử hồ sơ" FontWeight="Bold" Margin="0,12,0,4"/>
     <DataGrid ItemsSource="{Binding History}" IsReadOnly="True" AutoGenerateColumns="False" Height="150">
      <DataGrid.Columns><DataGridTextColumn Header="Thao tác" Binding="{Binding Action}" Width="150"/><DataGridTextColumn Header="Cán bộ" Binding="{Binding Actor}" Width="130"/><DataGridTextColumn Header="Thời điểm UTC" Binding="{Binding AtUtc}" Width="180"/><DataGridTextColumn Header="Căn cứ" Binding="{Binding Note}" Width="*"/></DataGrid.Columns>
     </DataGrid>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="3" Background="#E8EAF6" Padding="10" Margin="0,8,0,0"><TextBlock Text="{Binding Status}" FontWeight="SemiBold"/></Border>
 </Grid>
</UserControl>
